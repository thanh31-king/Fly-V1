-- LOGIC FLY VÀ ĐIỀU KHIỂN
-- ============================================================
local isFlying = false
local flySpeed = 50
local speedValue = 1
local controls = {f = 0, b = 0, l = 0, r = 0}
local lastControls = {f = 0, b = 0, l = 0, r = 0}

-- Nhận phím W/A/S/D cho PC
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not isFlying then return end
    if input.KeyCode == Enum.KeyCode.W then controls.f = 1 end
    if input.KeyCode == Enum.KeyCode.S then controls.b = -1 end
    if input.KeyCode == Enum.KeyCode.A then controls.l = -1 end
    if input.KeyCode == Enum.KeyCode.D then controls.r = 1 end
end)

UserInputService.InputEnded:Connect(function(input)
    if not isFlying then return end
    if input.KeyCode == Enum.KeyCode.W then controls.f = 0 end
    if input.KeyCode == Enum.KeyCode.S then controls.b = 0 end
    if input.KeyCode == Enum.KeyCode.A then controls.l = 0 end
    if input.KeyCode == Enum.KeyCode.D then controls.r = 0 end
end)

-- Hàm bật/tắt Fly
local function ToggleFly()
    isFlying = not isFlying
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char.HumanoidRootPart
    
    if isFlying then
        onof.Text = "OFF"
        onof.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        hum.PlatformStand = true
        
        local bv = Instance.new("BodyVelocity", root)
        bv.Name = "VantaFlyVelocity"
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.new(0, 0, 0)
        
        local bg = Instance.new("BodyGyro", root)
        bg.Name = "VantaFlyGyro"
        bg.P = 9e4
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.CFrame = root.CFrame

        -- Vòng lặp bay
        task.spawn(function()
            local speed = 0
            while isFlying and char.Parent and hum.Health > 0 do
                task.wait()
                if controls.l + controls.r ~= 0 or controls.f + controls.b ~= 0 then
                    speed = speed + 0.5 + (speed / flySpeed)
                    if speed > flySpeed then speed = flySpeed end
                elseif speed ~= 0 then
                    speed = speed - 1
                    if speed < 0 then speed = 0 end
                end
                
                if (controls.l + controls.r) ~= 0 or (controls.f + controls.b) ~= 0 then
                    bv.Velocity = ((workspace.CurrentCamera.CFrame.LookVector * (controls.f + controls.b)) + ((workspace.CurrentCamera.CFrame * CFrame.new(controls.l + controls.r, (controls.f + controls.b) * .2, 0).p) - workspace.CurrentCamera.CFrame.p)) * speed
                    lastControls = {f = controls.f, b = controls.b, l = controls.l, r = controls.r}
                elseif speed ~= 0 then
                    bv.Velocity = ((workspace.CurrentCamera.CFrame.LookVector * (lastControls.f + lastControls.b)) + ((workspace.CurrentCamera.CFrame * CFrame.new(lastControls.l + lastControls.r, (lastControls.f + lastControls.b) * .2, 0).p) - workspace.CurrentCamera.CFrame.p)) * speed
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
                
                bg.CFrame = workspace.CurrentCamera.CFrame * CFrame.Angles(-math.rad((controls.f + controls.b) * 50 * speed / flySpeed), 0, 0)
            end
            
            -- Dọn dẹp
            if root:FindFirstChild("VantaFlyVelocity") then root.VantaFlyVelocity:Destroy() end
            if root:FindFirstChild("VantaFlyGyro") then root.VantaFlyGyro:Destroy() end
            if hum then hum.PlatformStand = false end
        end)
    else
        onof.Text = "fly"
        onof.BackgroundColor3 = Color3.fromRGB(255, 249, 74)
        hum.PlatformStand = false
        local bv = root:FindFirstChild("VantaFlyVelocity")
        local bg = root:FindFirstChild("VantaFlyGyro")
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end
end

onof.MouseButton1Click:Connect(ToggleFly)

-- Xử lý nút UP / DOWN (Hỗ trợ cả PC và Mobile nhấn giữ)
local upConnection = nil
up.MouseButton1Down:Connect(function()
    if upConnection then upConnection:Disconnect() end
    upConnection = RunService.Heartbeat:Connect(function()
        if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            Player.Character.HumanoidRootPart.CFrame = Player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 1, 0)
        end
    end)
end)
up.MouseButton1Up:Connect(function() if upConnection then upConnection:Disconnect(); upConnection = nil end end)

local downConnection = nil
down.MouseButton1Down:Connect(function()
    if downConnection then downConnection:Disconnect() end
    downConnection = RunService.Heartbeat:Connect(function()
        if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            Player.Character.HumanoidRootPart.CFrame = Player.Character.HumanoidRootPart.CFrame * CFrame.new(0, -1, 0)
        end
    end)
end)
down.MouseButton1Up:Connect(function() if downConnection then downConnection:Disconnect(); downConnection = nil end end)

-- Tăng/Giảm tốc độ
plus.MouseButton1Click:Connect(function()
    speedValue = speedValue + 1
    flySpeed = flySpeed + 10
    speedLabel.Text = tostring(speedValue)
end)

mine.MouseButton1Click:Connect(function()
    if speedValue > 1 then
        speedValue = speedValue - 1
        flySpeed = flySpeed - 10
        speedLabel.Text = tostring(speedValue)
    else
        speedLabel.Text = 'Min'
        task.wait(1)
        speedLabel.Text = tostring(speedValue)
    end
end)

